# Zugangsdaten und Interna nie ausliefern
<FilesMatch "^(config\.php|config\.example\.php|\.ftp-deploy-sync-state\.json|maintenance\.flag)$">
  Require all denied
</FilesMatch>
Options -Indexes
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
# HTTPS erzwingen
RewriteEngine On
# www auf Hauptadresse
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteRule ^kalender/([A-Za-z0-9]{32})\.ics$ ics.php?t=$1 [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^lib/ - [F,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Bilder von Filmen und Serien: fehlt die Datei, holt pic.php sie einmal
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^bilder/((t|m)/.+)$ pic.php?p=$1 [L,QSA]
# Einblick für Gäste (Beispielnutzer)
RewriteRule ^einblick/?$ einblick.php?s=kalender [L,QSA]
RewriteRule ^einblick/(kalender|serien|community)/?$ einblick.php?s=$1 [L,QSA]
# Öffentliche Neuerscheinungen je Kalenderwoche
RewriteRule ^neuerscheinungen/?$ neuerscheinungen.php [L,QSA]
RewriteRule ^neuerscheinungen/([0-9]{4}-[Kk][Ww][0-9]{1,2})/?$ neuerscheinungen.php?w=$1 [L,QSA]
RewriteRule ^einblick/serie/([0-9]+)(-[a-z0-9-]*)?/?$ einblick.php?s=serie&id=$1 [L,QSA]
